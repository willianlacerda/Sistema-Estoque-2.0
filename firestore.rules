rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // 1. GLOBAL SAFETY NET (Default Deny)
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // 2. GLOBAL VALIDATION PRIMITIVES
    // =========================================================================
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSharedWorkspace(data) {
      return data.workspaceId is string && data.workspaceId == 'dm-santos-central' && data.workspaceId.size() <= 40;
    }

    // =========================================================================
    // 3. VALIDATION BLUEPRINTS (Strict Schema, Size & Boundary Enforcements)
    // =========================================================================

    function isValidAccount(data, accountId) {
      return data.keys().hasAll(['id', 'workspaceId', 'username', 'passwordHash', 'nivel', 'roleName', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'workspaceId', 'username', 'passwordHash', 'nivel', 'roleName', 'createdAt', 'updatedAt']) &&
        data.id is string && data.id == accountId && isValidId(data.id) &&
        isSharedWorkspace(data) &&
        data.username is string && data.username.size() >= 1 && data.username.size() <= 100 &&
        data.passwordHash is string && data.passwordHash.size() >= 1 && data.passwordHash.size() <= 128 &&
        data.nivel in [1, 2] &&
        data.roleName in ['Operador', 'Administrador'] &&
        ((data.nivel == 2 && data.roleName == 'Administrador') || (data.nivel == 1 && data.roleName == 'Operador')) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidProduct(data, productId) {
      return data.keys().hasAll([
          'id', 'workspaceId', 'numero', 'nome', 'quantidade',
          'estoqueMinimo', 'unidade', 'categoria', 'ultimaAtualizacao',
          'inativo', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'workspaceId', 'numero', 'nome', 'quantidade',
          'estoqueMinimo', 'unidade', 'categoria', 'ultimaAtualizacao',
          'inativo', 'createdAt', 'updatedAt'
        ]) &&
        data.id is string && data.id == productId && isValidId(data.id) &&
        isSharedWorkspace(data) &&
        data.numero is int && data.numero >= 1 && data.numero <= 1000000 &&
        data.nome is string && data.nome.size() >= 1 && data.nome.size() <= 180 &&
        data.quantidade is number && data.quantidade >= 0 && data.quantidade <= 100000000 &&
        data.estoqueMinimo is number && data.estoqueMinimo >= 0 && data.estoqueMinimo <= 100000000 &&
        data.unidade is string && data.unidade.size() >= 1 && data.unidade.size() <= 30 &&
        data.categoria is string && data.categoria.size() >= 1 && data.categoria.size() <= 60 &&
        data.ultimaAtualizacao is string && data.ultimaAtualizacao.size() >= 1 && data.ultimaAtualizacao.size() <= 40 &&
        data.inativo is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidMovement(data, movementId) {
      return data.keys().hasAll([
          'id', 'workspaceId', 'dataHora', 'numero', 'produto',
          'tipo', 'quantidade', 'usuario', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'workspaceId', 'productId', 'dataHora', 'numero', 'produto',
          'tipo', 'quantidade', 'usuario', 'saldoApos', 'observacao', 'createdAt'
        ]) &&
        data.id is string && data.id == movementId && isValidId(data.id) &&
        isSharedWorkspace(data) &&
        (!('productId' in data) || (data.productId is string && isValidId(data.productId))) &&
        data.dataHora is string && data.dataHora.size() >= 1 && data.dataHora.size() <= 40 &&
        data.numero is int && data.numero >= 1 && data.numero <= 1000000 &&
        data.produto is string && data.produto.size() >= 1 && data.produto.size() <= 180 &&
        data.tipo in ['Entrada', 'Saída'] &&
        data.quantidade is number && data.quantidade > 0 && data.quantidade <= 100000000 &&
        data.usuario is string && data.usuario.size() >= 1 && data.usuario.size() <= 100 &&
        (!('saldoApos' in data) || (data.saldoApos is number && data.saldoApos >= 0 && data.saldoApos <= 100000000)) &&
        (!('observacao' in data) || (data.observacao is string && data.observacao.size() <= 300)) &&
        data.createdAt is timestamp;
    }

    function isValidCategory(data, categoryId) {
      return data.keys().hasAll(['id', 'workspaceId', 'nome', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'workspaceId', 'nome', 'createdAt', 'updatedAt']) &&
        data.id is string && data.id == categoryId && isValidId(data.id) &&
        isSharedWorkspace(data) &&
        data.nome is string && data.nome.size() >= 1 && data.nome.size() <= 60 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidPackaging(data, packagingId) {
      return data.keys().hasAll(['id', 'workspaceId', 'sigla', 'nome', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'workspaceId', 'sigla', 'nome', 'createdAt', 'updatedAt']) &&
        data.id is string && data.id == packagingId && isValidId(data.id) &&
        isSharedWorkspace(data) &&
        data.sigla is string && data.sigla.size() >= 1 && data.sigla.size() <= 20 &&
        data.nome is string && data.nome.size() >= 1 && data.nome.size() <= 60 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidMetadata(data) {
      return data.keys().hasAll(['workspaceId', 'seeded', 'updatedAt']) &&
        data.keys().hasOnly(['workspaceId', 'seeded', 'updatedAt']) &&
        isSharedWorkspace(data) &&
        data.seeded is bool &&
        data.updatedAt is timestamp;
    }

    // =========================================================================
    // 4. SHARED WAREHOUSE COLLECTIONS (App-Managed Username/Password Login)
    // =========================================================================

    match /accounts/{accountId} {
      allow get: if isValidId(accountId) && existing().workspaceId == 'dm-santos-central';
      allow list: if resource.data.workspaceId == 'dm-santos-central';

      allow create: if isValidId(accountId) &&
        isValidAccount(incoming(), accountId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isValidId(accountId) &&
        isValidAccount(incoming(), accountId) &&
        incoming().id == existing().id &&
        incoming().workspaceId == existing().workspaceId &&
        incoming().username == existing().username &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (accountId != 'acc_willian' || (incoming().nivel == 2 && incoming().roleName == 'Administrador')) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['passwordHash', 'nivel', 'roleName', 'updatedAt']);

      allow delete: if isValidId(accountId) && accountId != 'acc_willian' && existing().workspaceId == 'dm-santos-central';
    }

    match /products/{productId} {
      allow get: if isValidId(productId) && existing().workspaceId == 'dm-santos-central';
      allow list: if resource.data.workspaceId == 'dm-santos-central';

      allow create: if isValidId(productId) &&
        isValidProduct(incoming(), productId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isValidId(productId) &&
        isValidProduct(incoming(), productId) &&
        incoming().id == existing().id &&
        incoming().workspaceId == existing().workspaceId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'numero', 'nome', 'quantidade', 'estoqueMinimo', 'unidade',
          'categoria', 'ultimaAtualizacao', 'inativo', 'updatedAt'
        ]);

      allow delete: if isValidId(productId) && existing().workspaceId == 'dm-santos-central';
    }

    match /movements/{movementId} {
      allow get: if isValidId(movementId) && existing().workspaceId == 'dm-santos-central';
      allow list: if resource.data.workspaceId == 'dm-santos-central';

      allow create: if isValidId(movementId) &&
        isValidMovement(incoming(), movementId) &&
        incoming().createdAt == request.time &&
        (!('productId' in incoming()) || existsAfter(/databases/$(database)/documents/products/$(incoming().productId)));

      // Audit logs are strictly immutable
      allow update: if false;

      allow delete: if isValidId(movementId) && existing().workspaceId == 'dm-santos-central';
    }

    match /categories/{categoryId} {
      allow get: if isValidId(categoryId) && existing().workspaceId == 'dm-santos-central';
      allow list: if resource.data.workspaceId == 'dm-santos-central';

      allow create: if isValidId(categoryId) &&
        isValidCategory(incoming(), categoryId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isValidId(categoryId) &&
        isValidCategory(incoming(), categoryId) &&
        incoming().id == existing().id &&
        incoming().workspaceId == existing().workspaceId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['nome', 'updatedAt']);

      allow delete: if isValidId(categoryId) && existing().workspaceId == 'dm-santos-central';
    }

    match /packagingTypes/{packagingId} {
      allow get: if isValidId(packagingId) && existing().workspaceId == 'dm-santos-central';
      allow list: if resource.data.workspaceId == 'dm-santos-central';

      allow create: if isValidId(packagingId) &&
        isValidPackaging(incoming(), packagingId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isValidId(packagingId) &&
        isValidPackaging(incoming(), packagingId) &&
        incoming().id == existing().id &&
        incoming().workspaceId == existing().workspaceId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['sigla', 'nome', 'updatedAt']);

      allow delete: if isValidId(packagingId) && existing().workspaceId == 'dm-santos-central';
    }

    match /metadata/{docId} {
      allow get: if isValidId(docId);
      allow list: if false;

      allow create: if isValidId(docId) &&
        isValidMetadata(incoming()) &&
        incoming().updatedAt == request.time;

      allow update: if isValidId(docId) &&
        isValidMetadata(incoming()) &&
        incoming().workspaceId == existing().workspaceId &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['seeded', 'updatedAt']);

      allow delete: if false;
    }
  }
}
